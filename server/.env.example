# 仅放在服务器。复制为 server/.env，填入有效供应商密钥。
# 使用 Node 20+：node --env-file=server/.env server/dify-bridge.js
PORT=8787
MODEL_BASE_URL=https://token.zju.edu.cn/v1/chat/completions
MODEL_API_KEY=
MODEL_NAME=deepseek-v4-flash-0731
MODEL_MAX_TOKENS=4000
# Reflex 与 Reframe 默认使用上面的已验证可用网关，按需显式覆盖。
# MODEL_FAST_BASE_URL=
# MODEL_FAST_API_KEY=
# MODEL_FAST_NAME=
# MODEL_REFRAME_BASE_URL=
# MODEL_REFRAME_API_KEY=
# MODEL_REFRAME_NAME=
MODEL_DEEP_NAME=glm-5.3-flash
MODEL_DEEP_MAX_TOKENS=20000
MODEL_TIMEOUT_MS=85000
# 若改用 Dify 聊天应用，清空 MODEL_* 配置再设置这些值。
# DIFY_BASE_URL=https://api.dify.ai/v1
# DIFY_API_KEY=
# PROMPT_VARIABLE=prompt
# 可选知识检索，失败不阻止聊天。
# DIFY_DATASET_KEY=
# DIFY_DATASET_IDS=
# 可选代理访问控制。此令牌不是供应商密钥；生产接入你自己的登录鉴权。
# AUTH_TOKEN=
