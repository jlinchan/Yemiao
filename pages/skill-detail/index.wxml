<view class="page-shell cat-page">
  <view class="topbar secondary-topbar" style="{{nav.topbarStyle}}">
    <button class="nav-back" bindtap="goBack" hover-class="is-pressed" aria-label="返回">
      <image class="nav-back-icon" src="/assets/agent/icons/chevron-right-muted.png" mode="aspectFit"/>
    </button>
    <text class="topbar-label">书中对话</text>
  </view>

  <scroll-view class="cat-scroll" scroll-y wx:if="{{book}}">
    <view class="cat-body" style="padding-top: {{nav.navigationBottom}}px;">
      <view class="detail-head">
        <image class="detail-cover" src="{{book.cover}}" mode="aspectFill"></image>
        <view class="detail-copy">
          <text class="detail-title">{{book.title}}</text>
          <text class="detail-desc">{{book.desc}}</text>
          <text class="detail-meta">约 {{book.minutes}} 分钟 · {{book.steps.length}} 个引导问题</text>
        </view>
      </view>

      <text class="detail-summary">{{book.summary}}</text>

      <text class="step-heading">对话会这样进行</text>
      <view class="step-list">
        <view class="step" wx:for="{{book.steps}}" wx:key="title">
          <view class="step-index">{{index + 1}}</view>
          <view class="step-copy">
            <text class="step-title">{{item.title}}</text>
            <text class="step-detail">{{item.detail}}</text>
          </view>
        </view>
      </view>

      <button class="cat-cta detail-cta" bindtap="talkToNightcat" hover-class="is-pressed">开始和夜喵聊聊</button>

      <text class="cat-note">夜喵会用这本书的方法问你几个问题，不替你下结论。对话和记录只保存在本机。</text>
    </view>
  </scroll-view>
</view>
