<view class="record-page">
  <scroll-view class="record-scroll" scroll-y="{{!detail && !journalDetail}}">
    <view class="record-content" style="padding-top: {{nav.navigationBottom}}px;">
      <view class="record-header"><image class="header-art" src="/assets/record/header-cat.png" mode="aspectFill"/><view class="header-copy"><text class="record-title">记录</text><text class="muted">看看你的睡眠与心情轨迹</text></view></view>
      <view class="record-body">
        <view class="calendar-panel">
          <view class="month-nav"><button class="month-arrow" data-offset="-1" bindtap="changeMonth" aria-label="上个月"><image class="arrow-left" src="/assets/agent/icons/chevron-right-muted.png"/></button><text class="month-label">{{monthLabel}}</text><button class="month-arrow" data-offset="1" bindtap="changeMonth" aria-label="下个月"><image src="/assets/agent/icons/chevron-right-muted.png"/></button></view>
          <view class="calendar-row weekdays"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
          <view wx:for="{{rows}}" wx:key="key" class="calendar-row"><view wx:for="{{item.days}}" wx:for-item="day" wx:key="key" class="day-slot"><button class="day day--{{day.state}} {{day.outside ? 'day--outside' : ''}} {{day.selected ? 'day--selected' : ''}}" data-key="{{day.key}}" bindtap="chooseDate" aria-label="{{day.label}}"><text>{{day.day}}</text><view wx:if="{{day.today}}" class="today-mark"/></button></view></view>
          <text class="legend-title">上床时间</text><view class="legend"><text class="legend-early">●</text><text>早睡 21:00–23:00</text><text class="legend-middle">●</text><text>稍晚 23:00–00:30</text></view><view class="legend"><text class="legend-late">●</text><text>晚睡 00:30–04:59 · 归入前一晚</text></view>
        </view>
        <view class="weekly-banner"><image class="banner-art" src="/assets/record/weekly-banner.png" mode="aspectFill"/><view class="banner-copy"><view wx:if="{{weekly.total}}" class="weekly-title">本周早睡 <text class="gold-number">{{weekly.early}}</text> 天</view><text wx:else class="weekly-empty">本周还没有睡眠记录</text><text class="muted">{{weekly.total ? weekCopy : '记下上床时间，留下你的睡眠轨迹。'}}</text></view></view>
        <view class="journal-heading"><view><text class="section-title">感恩日记</text><text class="muted">记录生活中的小小光亮
让好心情陪你进入更好的睡眠</text></view><button class="all-button" bindtap="showAll">全部 <image src="/assets/agent/icons/chevron-right-muted.png"/></button></view>
        <button class="journal-entry" bindtap="writeJournal"><image class="banner-art" src="/assets/record/journal-entry.png" mode="aspectFill"/><view class="entry-copy"><text class="entry-title">今天想感谢什么？</text><text class="muted">写下让你感到温暖的事…</text></view><view class="entry-arrow"><image src="/assets/agent/icons/chevron-right-dark.png"/></view></button>
        <block wx:for="{{journals}}" wx:key="id"><view wx:if="{{index < 2}}" class="journal-row" data-id="{{item.id}}" bindtap="openJournal"><view class="journal-date"><text>{{item.date}}</text><text>{{item.weekday}}</text></view><image class="journal-thumb" src="/assets/record/journal-thumb.png" mode="aspectFill"/><text class="journal-summary">{{item.summary}}</text><button class="more-button" data-id="{{item.id}}" catchtap="journalActions" aria-label="日记更多操作">···</button></view></block>
        <text wx:if="{{!journals.length}}" class="empty-journal">还没有日记，今晚的温暖从这里开始。</text>
        <text wx:if="{{legacyCount}}" class="record-note">{{legacyCount}} 条旧睡眠记录缺少完整日期，可在睡眠录入页查看，暂不计入月历与周统计。</text>
        <text class="record-note">所有记录仅保存在当前设备</text>
      </view>
    </view>
  </scroll-view>
  <view class="record-tabbar">
    <night-tabbar active="records"></night-tabbar>
  </view>
  <view wx:if="{{allJournals}}" class="journal-all" style="padding-top: {{nav.navigationBottom}}px;">
    <view class="all-heading"><button bindtap="closeAll" aria-label="返回记录"><image src="/assets/agent/icons/arrow-left-muted.png"/></button><text class="section-title">感恩日记</text><button bindtap="writeJournal">写日记</button></view>
    <scroll-view class="all-scroll" scroll-y>
      <view class="all-list">
        <view wx:for="{{journals}}" wx:key="id" class="journal-row" data-id="{{item.id}}" bindtap="openJournal">
          <view class="journal-date"><text>{{item.date}}</text><text>{{item.weekday}}</text></view>
          <text class="journal-summary">{{item.summary}}</text>
          <button class="more-button" data-id="{{item.id}}" catchtap="journalActions" aria-label="日记更多操作">···</button>
        </view>
        <text wx:if="{{!journals.length}}" class="empty-journal">还没有日记</text>
      </view>
    </scroll-view>
  </view>
  <view wx:if="{{detail || journalDetail}}" class="detail-mask" catchtap="closeDetail"><view class="detail-sheet" catchtap="noop"><view class="detail-heading"><text class="section-title">{{detail ? '睡眠记录' : '感恩日记'}}</text><button bindtap="closeDetail" aria-label="关闭详情"><image src="/assets/agent/icons/x-muted.png"/></button></view><scroll-view class="detail-scroll" scroll-y><view wx:if="{{detail}}"><text class="detail-date">{{detail.nightDate}} 夜间</text><text class="detail-main">上床 {{detail.bedTime}} · {{detail.category}}</text><text class="muted">起床 {{detail.wakeTime}} · 感受 {{detail.feeling}} / 5</text><text class="record-note">颜色依据上床时间，不代表实际入睡时间。
05:00–20:59 为其他时段，不计入早睡天数。</text><button class="edit-button" bindtap="editSleep">编辑记录</button></view><view wx:if="{{journalDetail}}"><text class="detail-date">{{journalDetail.date}}</text><text wx:for="{{journalDetail.items}}" wx:key="index" class="journal-full">{{item}}</text></view></scroll-view></view></view>
</view>
