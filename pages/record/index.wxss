page { background: #002823; }
.record-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  height: 100dvh;
  overflow: hidden;
  background: linear-gradient(165deg, #001d1e 0%, #002e27 56%, #00251f 100%);
  color: #f5f1e2;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  letter-spacing: 0;
}
.record-page button { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background: transparent; color: inherit; line-height: 1.4; }
.record-page button::after { border: 0; }
.record-content { display: flex; flex: 1; flex-direction: column; min-height: 0; padding-right: 38rpx; padding-left: 38rpx; }
.record-header { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 12rpx; padding-top: 24rpx; }
.header-copy { flex: 1; min-width: 0; }
.record-title { display: block; font-size: 48rpx; font-weight: 700; line-height: 1.4; white-space: nowrap; }
.record-subtitle { display: block; margin-top: 4rpx; color: #9cb4a9; font-size: 26rpx; line-height: 1.7; }
.record-page .search-button { flex-shrink: 0; width: 76rpx; min-width: 40px; height: 76rpx; min-height: 40px; border: 1px solid #244b40; border-radius: 50%; background: #0b352e; }
.search-button image { width: 42rpx; height: 42rpx; }
.record-search { display: flex; flex-shrink: 0; align-items: center; gap: 16rpx; min-height: 88rpx; margin-top: 24rpx; padding: 0 22rpx; border: 1px solid #275344; border-radius: 12rpx; background: #0a382e; }
.search-field-icon { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.search-input { flex: 1; min-width: 0; height: 88rpx; color: #f5f1e2; font-size: 27rpx; }
.search-placeholder { color: #91aa9e; }
.record-page .clear-search { flex-shrink: 0; width: 64rpx; height: 80rpx; }
.clear-search image { width: 32rpx; height: 32rpx; }
.record-filters { display: flex; flex-shrink: 0; gap: 24rpx; padding-top: 30rpx; }
.record-page .filter-button { flex: 1; min-width: 0; height: 78rpx; border: 1px solid #17473c; border-radius: 48rpx; background: #002c26; color: #d2dfd3; font-size: 28rpx; font-weight: 500; white-space: nowrap; }
.record-page .filter-button.is-selected { border-color: #fff0bb; background: linear-gradient(110deg, #ffe49b, #ffedb5); color: #384334; font-weight: 600; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .16); }
.record-results { display: flex; flex: 1; min-height: 0; align-items: center; justify-content: center; }
.record-results.has-list { align-items: stretch; justify-content: flex-start; }
.session-scroll { flex: 1; min-height: 0; }
.session-list { display: flex; flex-direction: column; gap: 20rpx; padding: 30rpx 0; }
.session-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx; border: 1px solid #1c4a3e; border-radius: 20rpx;
  background: rgba(10, 56, 46, .55);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .04);
}
.session-item.is-live { border-color: rgba(255, 224, 155, .4); background: linear-gradient(150deg, rgba(255, 228, 155, .08), rgba(10, 56, 46, .55)); }
.session-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.session-title-row { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.session-title { min-width: 0; color: #f5f1e2; font-size: 28rpx; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.session-live { flex: none; padding: 2rpx 14rpx; border: 1px solid rgba(255, 224, 155, .4); border-radius: 999rpx; color: #ffe49b; font-size: 20rpx; line-height: 1.6; white-space: nowrap; }
.session-meta { color: #8ba99b; font-size: 22rpx; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.record-page .session-del { flex: none; align-self: center; margin-left: auto; width: 104rpx; min-width: 0; height: 56rpx; padding: 0; border: 1px solid #2a5548; border-radius: 999rpx; color: #9fb3ac; font-size: 22rpx; }
.record-empty { display: flex; flex-direction: column; align-items: center; gap: 28rpx; padding-bottom: 110rpx; }
.empty-icon { width: 112rpx; height: 112rpx; opacity: .56; }
.empty-title { color: #8ba99b; font-size: 28rpx; line-height: 1.6; }
.record-nav { display: flex; flex-shrink: 0; align-items: flex-start; min-height: calc(108rpx + env(safe-area-inset-bottom)); padding: 14rpx 24rpx calc(10rpx + env(safe-area-inset-bottom)); border-top: 1px solid #194237; background: #002b24; }
.record-nav button { flex: 1; flex-direction: column; gap: 6rpx; min-height: 84rpx; color: #9fb3ac; font-size: 25rpx; line-height: 1.4; }
.record-nav image { width: 46rpx; height: 46rpx; }
.record-nav .is-active { color: #f0dfa0; }
.is-pressed { opacity: .7; }
@media (max-height: 500px) {
  .record-header { padding-top: 8rpx; }
  .record-filters { padding-top: 16rpx; }
  .record-empty { gap: 12rpx; padding-bottom: 0; }
  .empty-icon { width: 72rpx; height: 72rpx; }
}
