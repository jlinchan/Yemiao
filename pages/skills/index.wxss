page { background:#021c1e; }
.skills-page .skills-heading { padding-left: max(44px, 90rpx); margin-bottom: 16rpx; }
.skills-heading .skills-back { position: absolute; left: 0; top: 50%; transform: translateY(-50%); flex: none; width: 44px; min-width: 44px; max-width: 44px; height: 44px; }
.skills-heading .skills-title { min-width: 0; font-size: 34rpx; line-height: 46rpx; }
.skills-page .skills-category-bar { margin: 0 28rpx; }
.skills-page .skills-categories { display: block; width: 100%; height: 54rpx; padding: 0; }
.skills-category-track { display: inline-flex; align-items: center; gap: 10rpx; padding-right: 2rpx; vertical-align: top; }
.skills-categories .category-pill { display: inline-flex; flex: 0 0 auto; width: auto; min-width: 104rpx; height: 52rpx; margin: 0; padding: 0 22rpx; font-size: 22rpx; line-height: 30rpx; vertical-align: middle; }
.skill-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx 10rpx; margin-top: auto; padding-top: 10rpx; }
.skill-actions .skill-tags { display: flex; flex: 1 1 210rpx; flex-wrap: wrap; gap: 6rpx; min-width: 0; margin-top: 0; }
.skills-page .skill-cta { display: flex; flex: 0 0 auto; align-self: center; width: 146rpx; max-width: 100%; height: 46rpx; margin: 0 0 0 auto; padding: 0 14rpx; border-radius: 23rpx; font-size: 19rpx; line-height: 27rpx; }
.skills-page .skill-cta text { font-size: 24rpx; }
.skills-page .skill-list { padding-bottom: calc(env(safe-area-inset-bottom) + 28rpx); }
.skills-page{--bg:#021c1e;--surface:#052527;--line:#234043;--gold:#ffe29a;--text:#f6f6ed;--sub:#b8cacb;--pill:#647b7c;height:100vh;overflow:hidden;background:var(--bg);color:var(--text);font-family:'Noto Sans SC','Microsoft YaHei',sans-serif}.skills-scroll{height:100%}.skills-header{position:relative;padding-bottom:20rpx}.moon-garden{position:absolute;right:24rpx;top:32rpx;width:120rpx;height:120rpx;border-radius:60rpx;background:#0a2b31;opacity:.92}.moon{position:absolute;top:22rpx;left:36rpx;width:48rpx;height:48rpx;border-radius:50%;background:var(--gold)}.moon:after{content:'';position:absolute;top:-6rpx;left:14rpx;width:48rpx;height:48rpx;border-radius:50%;background:#0a2b31}.star{position:absolute;width:6rpx;height:6rpx;border-radius:50%;background:var(--gold)}.star-a{left:20rpx;top:28rpx}.star-b{right:20rpx;top:58rpx}.star-c{left:48rpx;bottom:18rpx}.skills-heading{position:relative;display:flex;align-items:center;gap:8rpx;padding:0 28rpx}.skills-back{display:flex;align-items:center;justify-content:center;width:54rpx;height:64rpx;color:var(--text);font-size:56rpx;line-height:64rpx;background:transparent}.heading-copy{display:flex;flex-direction:column;gap:3rpx}.skills-title{font-size:38rpx;font-weight:700;line-height:52rpx}.skills-subtitle{font-size:20rpx;line-height:30rpx;color:var(--sub)}.skills-search{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;margin-left:auto;border:1rpx solid var(--pill);border-radius:18rpx;background:transparent}.skills-search image{width:28rpx;height:28rpx}.search-field{display:flex;align-items:center;height:70rpx;margin:0 28rpx 18rpx;padding:0 18rpx;border:1rpx solid var(--pill);border-radius:18rpx;background:var(--surface)}.search-input{flex:1;height:68rpx;color:var(--text);font-size:24rpx}.search-placeholder{color:#8caaaa}.search-clear{padding:14rpx 0 14rpx 18rpx;color:var(--gold);font-size:21rpx}.skills-categories{position:relative;display:flex;width:100%;padding:0 28rpx;box-sizing:border-box;white-space:nowrap}.category-pill{display:inline-flex;align-items:center;justify-content:center;width:auto;min-width:112rpx;height:48rpx;margin-right:10rpx;padding:0 20rpx;border:1rpx solid var(--pill);border-radius:24rpx;color:var(--sub);background:transparent;font-size:20rpx;line-height:28rpx;white-space:nowrap}.category-pill.is-selected{color:#0b170f;border-color:var(--gold);background:var(--gold)}.skills-intro{display:flex;flex-direction:column;gap:4rpx;margin:22rpx 28rpx 12rpx}.intro-title{font-size:30rpx;font-weight:700;line-height:42rpx}.intro-sub{font-size:21rpx;line-height:30rpx;color:var(--sub)}.skill-list{display:flex;flex-direction:column;gap:12rpx;margin:0 24rpx}.skill-card{display:flex;align-items:flex-start;gap:18rpx;min-height:164rpx;padding:14rpx;border:1rpx solid #496467;border-radius:24rpx;background:var(--surface);box-sizing:border-box}.skill-cover{position:relative;display:block;flex:0 0 29% !important;width:29% !important;min-width:0 !important;max-width:29% !important;height:136rpx;margin:0;padding:0;border:0;border-radius:18rpx;overflow:hidden;background:#0b3033;box-sizing:border-box}.skill-cover image{position:absolute;top:0;left:0;display:block;width:100% !important;height:100% !important;max-width:none !important;max-height:none !important;object-fit:cover}.cover-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(2,28,30,0),rgba(2,28,30,.22))}.skill-copy{display:flex;flex:1;flex-direction:column;min-width:0;padding:1rpx 0}.skill-title{display:-webkit-box;overflow:hidden;color:var(--text);font-size:26rpx;font-weight:700;line-height:34rpx;white-space:normal;-webkit-box-orient:vertical;-webkit-line-clamp:2}.skill-desc{display:-webkit-box;overflow:hidden;margin-top:4rpx;color:var(--sub);font-size:20rpx;line-height:28rpx;white-space:normal;-webkit-box-orient:vertical;-webkit-line-clamp:2}.skill-tags{display:flex;flex-wrap:wrap;gap:6rpx;margin-top:0}.skill-tag{flex:none;max-width:100%;padding:3rpx 9rpx;border:1rpx solid #8b8058;border-radius:99rpx;color:var(--gold);font-size:16rpx;line-height:22rpx;white-space:nowrap}.skill-cta{display:flex;align-items:center;justify-content:center;gap:6rpx;width:146rpx;height:46rpx;border-radius:23rpx;background:var(--gold);color:#0b170f;font-size:19rpx;line-height:27rpx}.skill-cta text{font-size:24rpx;line-height:20rpx}.directory-note{display:block;margin:20rpx 38rpx 0;padding-bottom:calc(env(safe-area-inset-bottom) + 28rpx);color:#8caaaa;font-size:19rpx;line-height:30rpx}.directory-empty{display:flex;align-items:center;flex-direction:column;gap:18rpx;padding:80rpx 24rpx;text-align:center}.empty-title{font-size:28rpx;line-height:40rpx}.empty-description{color:var(--sub);font-size:23rpx;line-height:34rpx}.empty-reset{padding:16rpx 28rpx;border-radius:99rpx;background:var(--gold);color:#0b170f;font-size:24rpx}.is-pressed{opacity:.72}
