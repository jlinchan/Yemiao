:host {
  position: absolute;
  z-index: 0;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: block;
  pointer-events: none;
}

.whale-page {
  --whale-ink: #020918;
  --whale-deep: #061d33;
  --whale-water: #224c7a;
  --whale-light: #60abe5;
  --whale-ray: #b9ddff;
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  background: var(--whale-ink);
  pointer-events: none;
}

.whale-art-stage,
.whale-water-caustics,
.whale-atmosphere,
.whale-rays,
.whale-ripples,
.whale-bubbles,
.whale-vignette {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
}

.whale-art-stage {
  z-index: 2;
  width: 100%;
  height: 177.78vw;
  max-height: 100%;
  overflow: hidden;
  background: #061d33;
}

.whale-water,
.whale-whale,
.whale-fin,
.whale-tail {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.whale-water {
  z-index: 0;
}

.whale-swimmer-frame {
  position: absolute;
  z-index: 1;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  transform: translate3d(-50%, -29%, 0) scale(0.84);
  transform-origin: 50% 54%;
}

.whale-phase-motion,
.whale-swim-cycle {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  backface-visibility: hidden;
  will-change: transform;
}

.whale-phase-motion {
  transform-origin: 50% 52%;
  will-change: transform, filter;
}

.whale-whale {
  z-index: 1;
}

.whale-fin {
  z-index: 2;
  opacity: 0.68;
  transform-origin: 42% 57%;
  animation-name: whaleFinStroke;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

.whale-tail {
  z-index: 3;
  opacity: 0.76;
  transform-origin: 82% 42%;
  animation-name: whaleTailStroke;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

.whale-page.is-idle .whale-swim-cycle {
  animation: whaleSwimIdle 8s ease-in-out infinite;
}

.whale-page--inhale .whale-swim-cycle {
  animation: whaleSwimInhale 4.1s ease-in-out infinite;
}

.whale-page--hold .whale-swim-cycle {
  animation: whaleSwimHold 6.1s ease-in-out infinite;
}

.whale-page--exhale .whale-swim-cycle {
  animation: whaleSwimExhale 7.3s ease-in-out infinite;
}

.whale-page.is-idle .whale-fin,
.whale-page--hold .whale-fin {
  animation-duration: 5.8s;
}

.whale-page--inhale .whale-fin {
  animation-duration: 3.6s;
}

.whale-page--exhale .whale-fin {
  animation-duration: 6.8s;
}

.whale-page.is-idle .whale-tail,
.whale-page--hold .whale-tail {
  animation-duration: 6.3s;
}

.whale-page--inhale .whale-tail {
  animation-duration: 3.9s;
}

.whale-page--exhale .whale-tail {
  animation-duration: 7.2s;
}

@keyframes whaleSwimIdle {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(-0.2deg); }
  50% { transform: translate3d(0, -16rpx, 0) rotate(0.24deg); }
}

@keyframes whaleSwimInhale {
  0%, 100% { transform: translate3d(0, 2rpx, 0) rotate(-0.46deg); }
  50% { transform: translate3d(0, -18rpx, 0) rotate(0.2deg); }
}

@keyframes whaleSwimHold {
  0%, 100% { transform: translate3d(0, -5rpx, 0) rotate(-0.22deg); }
  50% { transform: translate3d(0, -24rpx, 0) rotate(0.18deg); }
}

@keyframes whaleSwimExhale {
  0%, 100% { transform: translate3d(0, 25rpx, 0) rotate(0.5deg); }
  50% { transform: translate3d(0, 5rpx, 0) rotate(-0.22deg); }
}

@keyframes whaleTailStroke {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  50% { transform: translate3d(-14rpx, 10rpx, 0) rotate(-3deg); }
}

@keyframes whaleFinStroke {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  50% { transform: translate3d(8rpx, 8rpx, 0) rotate(2.8deg); }
}

.whale-water-caustics {
  z-index: 3;
  overflow: hidden;
  background:
    linear-gradient(104deg, rgba(142, 207, 255, 0) 0%, rgba(142, 207, 255, 0.08) 24%, rgba(142, 207, 255, 0) 45%),
    linear-gradient(76deg, rgba(93, 171, 235, 0) 8%, rgba(93, 171, 235, 0.07) 38%, rgba(93, 171, 235, 0) 64%);
  filter: blur(22rpx);
  animation: whaleCaustics 13s ease-in-out infinite;
  will-change: transform;
}

@keyframes whaleCaustics {
  0%, 100% { transform: translate3d(-2%, 0, 0) scale(1.04); }
  50% { transform: translate3d(2%, 16rpx, 0) scale(1.08); }
}

.whale-atmosphere {
  z-index: 4;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(125, 196, 255, 0.18), rgba(2, 14, 31, 0) 42%),
    linear-gradient(180deg, rgba(43, 119, 178, 0.06), rgba(2, 9, 24, 0.18) 66%, rgba(1, 6, 17, 0.4));
}

.whale-rays {
  z-index: 5;
  overflow: hidden;
}

.whale-rays::after {
  content: '';
  position: absolute;
  top: -16%;
  left: 50%;
  width: 820rpx;
  height: 1040rpx;
  transform: translateX(-50%);
  background: radial-gradient(ellipse at 50% 0%, rgba(173, 222, 255, 0.2), rgba(129, 195, 244, 0.06) 38%, rgba(34, 76, 122, 0) 72%);
  filter: blur(26rpx);
}

.whale-beam {
  position: absolute;
  top: -12%;
  height: 92%;
}

.whale-beam__body {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 50%;
  transform-origin: 50% 0;
  background: linear-gradient(180deg, rgba(190, 225, 255, 0.34), rgba(108, 178, 235, 0.13) 48%, rgba(64, 132, 196, 0) 96%);
  filter: blur(18rpx);
  will-change: opacity;
}

.whale-page.is-idle .whale-beam__body {
  animation-name: whaleBeamIdle;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

.whale-page--inhale .whale-beam__body {
  animation-name: whaleBeamInhale;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

.whale-page--hold .whale-beam__body {
  animation: none;
}

.whale-page--exhale .whale-beam__body {
  animation-name: whaleBeamExhale;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

@keyframes whaleBeamIdle {
  0%, 100% { opacity: 0.48; }
  50% { opacity: 0.78; }
}

@keyframes whaleBeamInhale {
  0% { opacity: 0.5; }
  40% { opacity: 0.9; }
  100% { opacity: 1; }
}

@keyframes whaleBeamExhale {
  0% { opacity: 0.92; }
  100% { opacity: 0.28; }
}

.whale-ripples {
  z-index: 6;
  top: -2%;
  bottom: auto;
  height: 30%;
  overflow: hidden;
}

.whale-ripple {
  position: absolute;
  left: 50%;
  top: 18rpx;
  border: 1rpx solid rgba(173, 219, 255, 0.28);
  border-radius: 50%;
  opacity: 0;
  transform: translate3d(-50%, 0, 0) scale(0.42);
  animation-name: whaleRipple;
  animation-timing-function: ease-out;
  animation-iteration-count: infinite;
  will-change: transform, opacity;
}

.whale-page--inhale .whale-ripple {
  animation-duration: 4s;
}

.whale-page--hold .whale-ripple {
  animation-duration: 7s;
}

.whale-page--exhale .whale-ripple {
  border-color: rgba(143, 191, 230, 0.16);
  animation-duration: 8s;
}

@keyframes whaleRipple {
  0% { opacity: 0; transform: translate3d(-50%, 0, 0) scale(0.36); }
  18% { opacity: 0.68; }
  100% { opacity: 0; transform: translate3d(-50%, 16rpx, 0) scale(1.22); }
}

.whale-bubbles {
  z-index: 7;
  overflow: hidden;
}

.whale-bubble {
  position: absolute;
  min-width: 4rpx;
  min-height: 4rpx;
  border: 1rpx solid rgba(199, 229, 255, 0.64);
  border-radius: 50%;
  background: radial-gradient(circle at 35% 28%, rgba(255, 255, 255, 0.76), rgba(154, 208, 250, 0.2) 36%, rgba(77, 143, 204, 0.08) 72%);
  box-shadow: 0 0 10rpx rgba(137, 205, 255, 0.34);
  opacity: 0.28;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  will-change: transform, opacity;
}

.whale-bubble::after {
  content: '';
  position: absolute;
  top: 18%;
  left: 22%;
  width: 28%;
  height: 28%;
  border-radius: 50%;
  background: rgba(245, 252, 255, 0.76);
}

.whale-page.is-idle .whale-bubble--0,
.whale-page--hold .whale-bubble--0 {
  animation-name: whaleBubbleHold0;
}

.whale-page.is-idle .whale-bubble--1,
.whale-page--hold .whale-bubble--1 {
  animation-name: whaleBubbleHold1;
}

.whale-page.is-idle .whale-bubble--2,
.whale-page--hold .whale-bubble--2 {
  animation-name: whaleBubbleHold2;
}

.whale-page--inhale .whale-bubble--0 {
  animation-name: whaleBubbleRise0;
}

.whale-page--inhale .whale-bubble--1 {
  animation-name: whaleBubbleRise1;
}

.whale-page--inhale .whale-bubble--2 {
  animation-name: whaleBubbleRise2;
}

.whale-page--exhale .whale-bubble--0 {
  animation-name: whaleBubbleSink0;
}

.whale-page--exhale .whale-bubble--1 {
  animation-name: whaleBubbleSink1;
}

.whale-page--exhale .whale-bubble--2 {
  animation-name: whaleBubbleSink2;
}

@keyframes whaleBubbleHold0 {
  0%, 100% { opacity: 0.22; transform: translate3d(0, 16rpx, 0) scale(0.88); }
  50% { opacity: 0.72; transform: translate3d(6rpx, -18rpx, 0) scale(1.08); }
}

@keyframes whaleBubbleHold1 {
  0%, 100% { opacity: 0.2; transform: translate3d(0, -12rpx, 0) scale(0.82); }
  50% { opacity: 0.66; transform: translate3d(-8rpx, 14rpx, 0) scale(1.04); }
}

@keyframes whaleBubbleHold2 {
  0%, 100% { opacity: 0.24; transform: translate3d(0, 8rpx, 0) scale(0.9); }
  50% { opacity: 0.74; transform: translate3d(4rpx, -22rpx, 0) scale(1.1); }
}

@keyframes whaleBubbleRise0 {
  0% { opacity: 0; transform: translate3d(0, 36rpx, 0) scale(0.62); }
  22% { opacity: 0.78; }
  100% { opacity: 0; transform: translate3d(18rpx, -170rpx, 0) scale(1.16); }
}

@keyframes whaleBubbleRise1 {
  0% { opacity: 0; transform: translate3d(0, 30rpx, 0) scale(0.58); }
  20% { opacity: 0.72; }
  100% { opacity: 0; transform: translate3d(-16rpx, -220rpx, 0) scale(1.08); }
}

@keyframes whaleBubbleRise2 {
  0% { opacity: 0; transform: translate3d(0, 44rpx, 0) scale(0.66); }
  25% { opacity: 0.84; }
  100% { opacity: 0; transform: translate3d(6rpx, -128rpx, 0) scale(1.22); }
}

@keyframes whaleBubbleSink0 {
  0% { opacity: 0; transform: translate3d(0, -22rpx, 0) scale(0.72); }
  24% { opacity: 0.42; }
  100% { opacity: 0; transform: translate3d(12rpx, 172rpx, 0) scale(0.92); }
}

@keyframes whaleBubbleSink1 {
  0% { opacity: 0; transform: translate3d(0, -30rpx, 0) scale(0.66); }
  20% { opacity: 0.36; }
  100% { opacity: 0; transform: translate3d(-14rpx, 214rpx, 0) scale(0.88); }
}

@keyframes whaleBubbleSink2 {
  0% { opacity: 0; transform: translate3d(0, -18rpx, 0) scale(0.76); }
  28% { opacity: 0.44; }
  100% { opacity: 0; transform: translate3d(4rpx, 142rpx, 0) scale(0.96); }
}

.whale-vignette {
  z-index: 8;
  background:
    radial-gradient(ellipse at 50% 42%, rgba(34, 76, 122, 0.02), rgba(1, 7, 18, 0.08) 58%, rgba(1, 6, 17, 0.44) 100%),
    linear-gradient(180deg, rgba(1, 8, 20, 0.05), rgba(1, 8, 20, 0) 24%, rgba(1, 6, 17, 0.04) 72%, rgba(1, 5, 15, 0.62));
}
