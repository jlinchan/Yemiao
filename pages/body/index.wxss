.body-page { height: 100vh; background: linear-gradient(180deg, #07191b, #041112 78%); }
.body-page .topbar { display: block; }
.body-page .topbar .icon-button--back { position: absolute; left: 0; bottom: 8px; }
.body-intro { padding: 34rpx 48rpx 0; text-align: center; }
.body-intro .page-title, .body-intro .page-copy { display: block; }
.body-scan-stage { position: absolute; top: 270rpx; right: 0; bottom: calc(env(safe-area-inset-bottom) + 30rpx); left: 0; width: 100%; }
.body-scan-stage world-visual { position: absolute; inset: 0; }
.body-figure { position: absolute; left: 50%; top: 50%; width: 410rpx; height: min(820rpx, 76vh); transform: translate(-50%, -50%); }
.body-silhouette { width: 100%; height: 100%; opacity: 0.9; filter: drop-shadow(0 0 28rpx rgba(120, 190, 170, 0.12)); }
.selected-point { position: absolute; z-index: 16; width: 30rpx; height: 30rpx; border-radius: 50%; transform: translate(-50%, -50%); background: rgba(212, 233, 203, .82); box-shadow: 0 0 54rpx 24rpx rgba(126, 207, 180, .5); pointer-events: none; }
.part-hotspot, .whole-body-hotspot { position: absolute; z-index: 15; display: flex; align-items: center; justify-content: center; width: 100rpx; height: 100rpx; padding: 0; transform: translate(-50%, -50%); background: transparent; }
.part-hotspot text, .whole-body-hotspot text { white-space: nowrap; }
.part-dot { width: 24rpx; height: 24rpx; border: 1rpx solid rgba(220, 237, 218, 0.45); border-radius: 50%; background: rgba(220, 237, 218, 0.12); opacity: 0; }
.part-hotspot.is-selected, .whole-body-hotspot.is-selected { color: var(--text-main); }
.is-selected .part-dot { border-color: #d4e9cb; background: #d4e9cb; box-shadow: 0 0 42rpx 18rpx rgba(126, 207, 180, 0.45); opacity: 1; }
.whole-body-hotspot { left: 50%; top: 94%; transform: translateX(-50%); }
.part-selector { display: none; }
.part-selector__inner { display: inline-flex; gap: 12rpx; padding: 0 40rpx; }
.part-chip { min-width: 92rpx; min-height: 68rpx; padding: 0 20rpx; border: 1rpx solid var(--line); border-radius: 34rpx; color: var(--text-faint); font-size: 23rpx; }
.part-chip.is-selected { color: var(--text-main); border-color: rgba(204, 227, 194, .5); background: rgba(204, 227, 194, .1); }

@media (max-height: 700px) {
  .body-scan-stage { top: 250rpx; bottom: calc(env(safe-area-inset-bottom) + 20rpx); }
}
