<view class="page-shell sound-page">
  <view class="topbar secondary-topbar" style="{{nav.topbarStyle}}"><button class="nav-back" bindtap="goBack" hover-class="is-pressed" aria-label="返回呼吸设置"><image class="nav-back-icon" src="/assets/agent/icons/chevron-right-muted.png" mode="aspectFit"/></button><text class="topbar-label">环境声音</text></view>
  <view class="sound-content">
    <text class="page-title">给呼吸留一点背景。</text>
    <text class="page-copy">声音会在呼吸过程中继续播放。</text>

    <view class="sound-list">
      <view wx:for="{{sounds}}" wx:key="id" class="sound-row {{selected === item.id ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="selectSound" hover-class="is-pressed" aria-role="button" aria-label="选择{{item.name}}，{{item.detail}}">
        <view class="sound-glyph">{{item.glyph}}</view>
        <view class="sound-copy"><text class="sound-name">{{item.name}}</text><text class="sound-detail">{{item.detail}}</text></view>
        <view class="sound-check">{{selected === item.id ? '✓' : ''}}</view>
      </view>
    </view>

    <view class="player-bar">
      <view class="play-button {{playing ? 'is-playing' : ''}}" bindtap="togglePlay" hover-class="is-pressed" aria-role="button" aria-label="{{playing ? '暂停声音' : '播放声音'}}">{{playing ? '❚❚' : '▶'}}</view>
      <view class="player-wave {{playing ? '' : 'is-still'}}" aria-hidden="true">
        <view class="wave-line"></view><view class="wave-line"></view><view class="wave-line"></view><view class="wave-line"></view><view class="wave-line"></view><view class="wave-line"></view><view class="wave-line"></view>
      </view>
      <text class="player-status">{{playing ? '播放中' : '已暂停'}}</text>
    </view>

    <view class="volume-row">
      <text class="volume-label">音量</text>
      <slider class="volume-slider" value="{{volume}}" activeColor="#e8c887" backgroundColor="rgba(255,255,255,.12)" block-size="20" block-color="#e8c887" bindchange="onVolumeChange"/>
      <text class="volume-value">{{volume}}</text>
    </view>

    <view class="timer-section">
      <text class="timer-label">睡眠定时</text>
      <view class="timer-options">
        <view wx:for="{{timerOptions}}" wx:key="*this" class="timer-chip {{timerMinutes === item ? 'is-selected' : ''}}" data-minutes="{{item}}" bindtap="chooseTimer" hover-class="is-pressed" aria-role="button" aria-label="{{item}}分钟后停止">{{item}} 分钟</view>
      </view>
      <text class="timer-note">到时会慢慢安静下来</text>
    </view>
  </view>
</view>
