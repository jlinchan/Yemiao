/* 环境声音页（2026-10-19 UI 重构）：与 agent 面板统一的夜色玻璃质感。
   交互元素全部改用 view（摆脱小程序 button 默认样式与超长单行 wxss 的解析隐患）。 */
.sound-page { min-height: 100vh; }
.topbar-label { color: var(--text-soft); font-size: 24rpx; letter-spacing: 2rpx; }
.topbar-spacer { width: 80rpx; }
.sound-content { padding: 56rpx 48rpx 80rpx; }

.sound-list { display: flex; flex-direction: column; gap: 14rpx; margin-top: 40rpx; }
.sound-row { display: flex; align-items: center; gap: 22rpx; padding: 20rpx 24rpx; border: 1rpx solid rgba(168,193,183,.14); border-radius: 18rpx; background: rgba(16,36,38,.5); transition: border-color .2s ease, background .2s ease; }
.sound-row.is-selected { border-color: rgba(232,200,135,.55); background: rgba(232,200,135,.08); }
.sound-glyph { flex: none; display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border: 1rpx solid rgba(168,193,183,.25); border-radius: 50%; color: #c3d4cf; font-size: 30rpx; }
.sound-row.is-selected .sound-glyph { color: #e8c887; border-color: rgba(232,200,135,.6); box-shadow: 0 0 24rpx rgba(232,200,135,.15); }
.sound-copy { flex: 1; min-width: 0; }
.sound-name { display: block; color: #e6efe9; font-size: 28rpx; }
.sound-detail { display: block; margin-top: 6rpx; color: rgba(195,212,207,.55); font-size: 22rpx; }
.sound-check { flex: none; width: 40rpx; text-align: center; color: #e8c887; font-size: 30rpx; }

.player-bar { display: flex; align-items: center; gap: 24rpx; margin-top: 40rpx; padding: 24rpx 28rpx; border: 1rpx solid rgba(168,193,183,.14); border-radius: 20rpx; background: rgba(16,36,38,.5); }
.play-button { flex: none; display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 50%; background: linear-gradient(160deg, #e8c887, #d3ab5f); color: #10231f; font-size: 30rpx; box-shadow: 0 6rpx 24rpx rgba(232,200,135,.22); }
.play-button.is-playing { box-shadow: 0 6rpx 28rpx rgba(232,200,135,.32); }
.player-wave { display: flex; align-items: center; gap: 6rpx; flex: 1; height: 52rpx; }
.wave-line { width: 4rpx; height: 20rpx; border-radius: 2rpx; background: rgba(232,200,135,.75); animation: sound-wave 1.1s ease-in-out infinite alternate; }
.wave-line:nth-child(2) { animation-delay: -.8s; height: 34rpx; }
.wave-line:nth-child(3) { animation-delay: -.5s; height: 24rpx; }
.wave-line:nth-child(4) { animation-delay: -.2s; height: 44rpx; }
.wave-line:nth-child(5) { animation-delay: -.6s; height: 28rpx; }
.wave-line:nth-child(6) { animation-delay: -.9s; height: 36rpx; }
.wave-line:nth-child(7) { animation-delay: -.3s; height: 18rpx; }
@keyframes sound-wave { from { transform: scaleY(.45); opacity: .5; } to { transform: scaleY(1); opacity: 1; } }
.player-wave.is-still .wave-line { animation-play-state: paused; opacity: .4; transform: scaleY(.5); }
.player-status { flex: none; color: rgba(195,212,207,.65); font-size: 22rpx; }

.volume-row { display: flex; align-items: center; gap: 20rpx; margin-top: 30rpx; }
.volume-label, .volume-value { flex: none; color: rgba(195,212,207,.6); font-size: 22rpx; }
.volume-value { min-width: 48rpx; text-align: right; color: #e6efe9; }
.volume-slider { flex: 1; margin: 0; }

.timer-section { margin-top: 44rpx; padding-top: 32rpx; border-top: 1rpx solid rgba(168,193,183,.12); }
.timer-label, .timer-note { display: block; color: rgba(195,212,207,.55); font-size: 22rpx; }
.timer-options { display: flex; gap: 14rpx; margin: 18rpx 0 16rpx; }
.timer-chip { display: flex; flex: 1; align-items: center; justify-content: center; min-height: 78rpx; border: 1rpx solid rgba(168,193,183,.18); border-radius: 999rpx; color: #c3d4cf; font-size: 24rpx; transition: border-color .2s ease, background .2s ease; }
.timer-chip.is-selected { color: #e8c887; border-color: rgba(232,200,135,.55); background: rgba(232,200,135,.08); }
