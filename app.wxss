page {
  --bg-deep: #061719;
  --bg-mid: #081d20;
  --bg-soft: #0b2525;
  --text-main: rgba(255, 255, 255, 0.92);
  --text-soft: rgba(255, 255, 255, 0.62);
  --text-faint: rgba(255, 255, 255, 0.38);
  --line: rgba(255, 255, 255, 0.1);
  --accent: #cce3c2;
  min-height: 100%;
  background: var(--bg-deep);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, textarea, slider, picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
  color: inherit;
  font: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 44%, rgba(73, 120, 105, 0.12), transparent 42%),
    linear-gradient(180deg, var(--bg-mid), var(--bg-deep) 74%);
}

.safe-top {
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
}

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

.topbar {
  position: relative;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 32rpx;
}

.secondary-topbar {
  display: block;
}

.topbar .icon-button--back {
  position: absolute;
  left: 0;
  bottom: 8px;
  width: 44px;
  min-width: 44px;
  max-width: 44px;
  height: 44px;
}

.secondary-topbar .topbar-label {
  position: absolute;
  left: 50%;
  bottom: 17px;
  transform: translateX(-50%);
  white-space: nowrap;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  color: var(--text-soft);
  background: rgba(255, 255, 255, 0.04);
}

.icon-button--wide {
  width: auto;
  min-width: 128rpx;
  padding: 0 22rpx;
  gap: 10rpx;
  border-radius: 40rpx;
}

.icon-button--back {
  width: 80rpx;
  min-width: 80rpx;
  padding: 0;
  border-radius: 50%;
  color: var(--text-main);
  background: rgba(255, 255, 255, 0.065);
  font-size: 24rpx;
}

.back-arrow {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.back-arrow::after {
  content: '';
  position: absolute;
  left: -2rpx;
  bottom: -2rpx;
  width: 24rpx;
  height: 3rpx;
  transform-origin: left center;
  transform: rotate(-45deg);
  background: currentColor;
}

.close-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.close-icon::before,
.close-icon::after {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 1rpx;
  width: 2rpx;
  height: 26rpx;
  background: currentColor;
}

.close-icon::before { transform: rotate(45deg); }
.close-icon::after { transform: rotate(-45deg); }

.page-title {
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: 0;
}

.page-copy {
  margin-top: 16rpx;
  color: var(--text-soft);
  font-size: 28rpx;
  line-height: 1.8;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  border-radius: 8rpx;
  color: #0a1b19;
  background: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  color: var(--text-soft);
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
}

.text-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 24rpx;
  color: var(--text-soft);
}

.sheet-mask {
  position: fixed;
  z-index: 80;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 8, 9, 0.66);
  opacity: 0;
  pointer-events: none;
  transition: opacity 240ms ease;
}

.sheet-mask.is-open {
  opacity: 1;
  pointer-events: auto;
}

.bottom-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 84vh;
  padding: 18rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  overflow: hidden;
  border-top: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 8rpx 8rpx 0 0;
  background: #0b2021;
  transform: translateY(104%);
  transition: transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.is-open .bottom-sheet {
  transform: translateY(0);
}

.sheet-handle {
  width: 68rpx;
  height: 6rpx;
  margin: 2rpx auto 28rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.18);
}

.sheet-title {
  margin-bottom: 22rpx;
  font-size: 34rpx;
  font-weight: 500;
}

.sheet-close {
  position: absolute;
  top: 18rpx;
  right: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  color: var(--text-soft);
  background: rgba(255, 255, 255, 0.05);
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--line);
}

.setting-label {
  color: var(--text-main);
}

.setting-value {
  color: var(--text-soft);
}

.form-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--text-soft);
  font-size: 24rpx;
}

.form-input,
.form-textarea,
.picker-field {
  width: 100%;
  color: var(--text-main);
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.035);
}

.form-input,
.picker-field {
  min-height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.form-textarea {
  min-height: 156rpx;
  padding: 22rpx 24rpx;
  line-height: 1.65;
}

.section-divider {
  height: 1rpx;
  margin: 28rpx 0;
  background: var(--line);
}

.sr-only {
  position: absolute;
  left: -10000rpx;
  top: -10000rpx;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
  white-space: nowrap;
  border: 0;
}
